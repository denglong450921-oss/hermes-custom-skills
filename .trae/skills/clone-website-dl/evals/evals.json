        "files": {"spec-template": "references/spec-template.md"},
        "tools_available": ["spec_template", "pre_dispatch_checklist"]
      },
      "tools": ["spec_template"],
      "grader": {
        "must_use": ["spec_has_all_sections", "spec_has_css_values", "spec_has_states", "spec_has_assets"],
        "must_have": ["Overview", "Props Interface", "DOM Structure", "Computed Styles", "States & Behaviors", "Assets", "Text Content", "Implementation Notes", "Responsive Behavior"],
        "must_not_have": ["TODO", "FIXME", "estimated", "looks like", "approximately"]
      },
      "grader_file": "../clone-website-build-dl/references/spec-template.md"
    },
    {
      "id": "case_002",
      "name": "css-extraction-accuracy",
